# Reviewed reference text is hash-pinned and must have identical bytes on all hosts.
data/reference/*.csv text eol=lf
data/reference/*.json text eol=lf
# Tracked ACARA inputs are also byte-pinned by the inputs manifest.
data/external/school-location-2022.csv text eol=lf
data/external/school-profile-2022.csv text eol=lf
data/external/acara_school_results.json text eol=lf
# These snapshots preserve the exact previous working files, including newlines.
archive/reference/2026-10-02/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
archive/inputs/2026-10-02/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
archive/input-provisioning/2026-10-02/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
archive/notebooks/2026-10-02/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the exact verified release bytes and their report checksums.
data/processed/historical/0.3.0/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Candidate inventories retain the exact bytes delivered in release archives.
docs/releases/**/manifest.json -text
docs/releases/**/candidate-record.json text eol=lf
docs/releases/**/SHA256SUMS -text
